# AI provider config for server/app.py
# Modes:
# - local : always use local DB-based assistant (no external API)
# - auto  : use xAI, fallback to local on errors
# - xai   : strict xAI only
AI_ASSISTANT_MODE=local

# xAI settings (needed for auto/xai modes)
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-3-mini

# Telegram bot settings for adaptive interview notifications
# Bot API cannot send by phone number; use chat_id.
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_DEFAULT_CHAT_ID=123456789

# Public base URL for links sent to Telegram (optional)
# Example: https://your-domain.com
APP_PUBLIC_URL=
